---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="on-dark relative overflow-hidden bg-night text-white">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-page relative py-28 text-center sm:py-36">
      <p class="font-mono text-sm text-signal">[ 404 · NOTHING DETECTED ]</p>
      <h1 class="mt-5 text-4xl font-semibold sm:text-6xl">We couldn't find that page.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-night-text">It may have moved when we rebuilt the site. Try one of these instead.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href="/" variant="bright" size="lg">Home</Button>
        <Button href="/products/hr-payroll" variant="outline-dark" size="lg">HR &amp; Payroll</Button>
        <Button href="/work" variant="outline-dark" size="lg">Our work</Button>
        <Button href="/contact" variant="outline-dark" size="lg">Contact</Button>
      </div>
    </div>
  </section>
</BaseLayout>
