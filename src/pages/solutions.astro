---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../sections/PageHero.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import CTA from '../sections/CTA.astro';
import { solutions } from '../data/resources';
---
<BaseLayout title="Solutions" description="How Bracket Systems helps HR and payroll teams, growing businesses, schools and institutions, safety and operations teams, and IT teams.">
  <PageHero tag="[ SOLUTIONS ]" title="Solutions by the people who use them." lead="Where our product and our services fit — for the team you're on." />
  <nav aria-label="Solutions" class="sticky top-16 z-30 border-b border-line bg-paper/90 backdrop-blur">
    <ul class="container-page flex gap-1 overflow-x-auto py-2 [scrollbar-width:none]">
      {solutions.map((s) => <li><a href={`#${s.id}`} class="block rounded-full px-3 py-1.5 text-sm whitespace-nowrap text-ink-3 hover:bg-tray hover:text-ink">{s.title}</a></li>)}
    </ul>
  </nav>
  <div class="py-12 sm:py-16">
    {solutions.map((s) => (
      <section id={s.id} class="scroll-mt-32 py-8 sm:py-10">
        <div data-reveal class="container-page grid gap-8 rounded-3xl lg:grid-cols-[1fr_1fr]">
          <div>
            <span class="grid size-12 place-items-center rounded-2xl bg-ink text-signal"><Icon name={s.icon} size={24} /></span>
            <p class="mt-5 font-mono text-xs tracking-wider text-muted uppercase">{s.who}</p>
            <h2 class="mt-2 text-3xl font-semibold">{s.title}</h2>
            <p class="mt-3 text-lg text-muted">{s.body}</p>
            <div class="mt-6"><Button href={s.cta.href} variant="secondary" icon="arrow">{s.cta.label}</Button></div>
          </div>
          <ul class="grid content-start gap-3">
            {s.points.map((pt) => <li class="flex gap-3 rounded-xl bg-panel p-4 text-ink-3 ring-1 ring-line"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-accent" />{pt}</li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>
  <CTA />
</BaseLayout>
