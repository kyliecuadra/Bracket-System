---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../sections/PageHero.astro';
import ProductFrame from '../../components/ProductFrame.astro';
import Button from '../../components/Button.astro';
import CTA from '../../sections/CTA.astro';
import { products } from '../../data/products';
---
<BaseLayout title="Products" description="Software products by Bracket Systems, starting with HR & Payroll: HR management and Philippine payroll in one platform.">
  <PageHero tag="[ PRODUCTS ]" title="Products" lead="Alongside client work, we build and maintain our own software. HR & Payroll is the first." />
  <section class="py-20 sm:py-24">
    <div class="container-page space-y-10">
      {products.map((p) => (
        <article data-reveal class="grid items-center gap-10 rounded-3xl bg-panel p-6 ring-1 ring-line sm:p-10 lg:grid-cols-[1fr_1.3fr]">
          <div>
            <p class="tag">{p.tag}</p>
            <h2 class="mt-3 text-3xl font-semibold">{p.fullName}</h2>
            <p class="mt-3 text-lg text-ink-3">{p.headline}</p>
            <p class="mt-3 text-muted">{p.summary}</p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href={`/products/${p.slug}`} icon="arrow">View product</Button>
              <Button href="/demo" variant="secondary">Product tour</Button>
            </div>
          </div>
          <ProductFrame id={p.heroShot} route="/dashboard" alt={`${p.fullName} dashboard (fictional demo data)`} sizes="(min-width: 1024px) 640px, 100vw" />
        </article>
      ))}
    </div>
  </section>
  <CTA title="Have a product idea of your own?" lead="We build custom platforms too — from web apps to computer vision." />
</BaseLayout>
