---
import Button from '../components/Button.astro';

interface Props { title?: string; lead?: string }
const {
  title = 'See HR & Payroll with your own questions.',
  lead = 'Book a walkthrough of the running product, or tell us what you want to build. You\'ll hear back from the team directly.',
} = Astro.props;
---
<section class="py-20 sm:py-24">
  <div class="container-page">
    <div data-reveal class="on-dark relative overflow-hidden rounded-3xl bg-ink px-6 py-14 text-center sm:px-12 sm:py-16">
      <div class="grid-bg pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 left-1/2 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-accent/35 blur-[100px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-2xl">
        <p class="tag">[ LET'S TALK ]</p>
        <h2 class="mt-4 text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg text-night-text">{lead}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/demo#request" variant="bright" size="lg" icon="arrow">Request a demo</Button>
          <Button href="/contact" variant="outline-dark" size="lg">Build with us</Button>
        </div>
      </div>
    </div>
  </div>
</section>
