---
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { controls } from '../data/security';

const highlights = controls.filter((c) => c.status === 'implemented').slice(0, 6);
---
<section class="on-dark relative overflow-hidden bg-night py-24 text-white">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="container-page relative">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <SectionHeader dark tag="[ SECURITY & RELIABILITY ]" title="Built for data people trust you with." lead="Payroll and HR records are some of the most sensitive data a company holds. These controls are in the product today — and we're clear about the ones that depend on your installation." />
      <Button href="/security" variant="outline-dark" icon="arrow">Security overview</Button>
    </div>
    <ul class="mt-14 grid gap-px overflow-hidden rounded-[var(--radius-card)] bg-night-line ring-1 ring-night-line sm:grid-cols-2 lg:grid-cols-3">
      {highlights.map((c) => (
        <li data-reveal class="bg-night-2 p-6">
          <Icon name={c.icon} size={22} class="text-signal" />
          <h3 class="mt-4 font-semibold text-white">{c.title}</h3>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-night-text">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
