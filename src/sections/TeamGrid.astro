---
import Icon from '../components/Icon.astro';
import { team } from '../data/team';
---
<ul class="grid gap-5 md:grid-cols-3">
  {team.map((m) => (
    <li data-reveal class="flex flex-col rounded-[var(--radius-card)] bg-panel p-6 shadow-[var(--shadow-card)] ring-1 ring-line">
      <div class="flex items-center gap-4">
        <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-ink font-mono text-base font-semibold tracking-wider text-signal" aria-hidden="true">{m.initials}</span>
        <div>
          <h3 class="text-lg font-semibold text-ink">{m.name}</h3>
          <p class="font-mono text-[0.72rem] leading-snug text-muted">{m.role}</p>
        </div>
      </div>
      <p class="mt-4 flex items-center gap-2 text-sm text-accent"><span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>{m.availability}</p>
      <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-3">{m.bio}</p>
      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`${m.name}'s skills`}>
        {m.skills.map((s) => <li class="rounded-full bg-tray px-2.5 py-1 font-mono text-[0.7rem] text-ink-3">{s}</li>)}
      </ul>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-sm">
        <a href={`mailto:${m.email}`} class="inline-flex min-w-0 items-center gap-1.5 text-ink hover:text-accent"><Icon name="mail" size={15} /><span class="truncate">{m.email}</span></a>
        <a href={m.resume} class="font-medium text-accent hover:underline" target="_blank" rel="noopener">Résumé<span class="sr-only"> of {m.name} (PDF)</span></a>
        {m.links?.map((l) => <a href={l.href} class="font-medium text-accent hover:underline" target="_blank" rel="noopener noreferrer">{l.label}<span class="sr-only"> of {m.name}</span></a>)}
      </div>
    </li>
  ))}
</ul>
