---
import Icon from '../components/Icon.astro';
import { projects } from '../data/work';

interface Props { limit?: number }
const { limit } = Astro.props;
const list = limit ? projects.slice(0, limit) : projects;
---
<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {list.map((p) => (
    <li data-reveal>
      <a href={`/work/${p.slug}`} class="group flex h-full flex-col rounded-[var(--radius-card)] bg-panel p-6 shadow-[var(--shadow-card)] ring-1 ring-line transition hover:-translate-y-0.5 hover:ring-ink/25">
        <p class="tag">{p.tag}</p>
        <h3 class="mt-3 text-lg font-semibold text-ink">{p.title}</h3>
        {p.client && <p class="mt-1 text-sm font-medium text-accent">For {p.client}</p>}
        <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">{p.summary}</p>
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technology">
          {p.stack.map((t) => <li class="rounded-full bg-tray px-2.5 py-1 font-mono text-[0.7rem] text-ink-3">{t}</li>)}
        </ul>
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-ink">Read more <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" /></span>
      </a>
    </li>
  ))}
</ul>
