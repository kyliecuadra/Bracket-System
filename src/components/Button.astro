---
import Icon from './Icon.astro';
import type { IconName } from '../data/types';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'bright' | 'outline-dark';
  icon?: IconName;
  size?: 'md' | 'lg';
  class?: string;
  external?: boolean;
}
const { href, variant = 'primary', icon, size = 'md', class: className, external } = Astro.props;
const styles = {
  primary: 'bg-ink text-white hover:bg-ink-2 shadow-sm',
  secondary: 'bg-panel text-ink ring-1 ring-line-strong hover:ring-ink-3',
  ghost: 'text-ink hover:bg-tray',
  bright: 'bg-signal text-ink hover:bg-white',
  'outline-dark': 'text-white ring-1 ring-white/25 hover:ring-white/60 hover:bg-white/5',
}[variant];
---
<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-full font-medium transition-colors duration-200',
    size === 'lg' ? 'h-12 px-6 text-[0.95rem]' : 'h-10 px-5 text-sm',
    styles,
    className,
  ]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {icon && <Icon name={icon} size={16} class="transition-transform duration-200 group-hover:translate-x-0.5" />}
</a>
